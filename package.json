{
  "name": "pi-artifacts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pi-artifacts": "dist/service/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/artifacts.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "biome check . && node scripts/doc-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test:discover": "node scripts/discover.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:coverage": "node scripts/test.mjs coverage"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.2.1",
    "esbuild": "0.27.4",
    "lucide-react": "0.577.0",
    "marked": "17.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "typebox": "1.3.27",
    "vitest": "3.2.4"
  }
}
